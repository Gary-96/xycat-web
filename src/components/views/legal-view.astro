---
// 2026-10-24 - 法律条款页（隐私政策 / 服务条款）共用视图，中英文案由字典提供。
// kind 决定渲染哪一份文档，避免中英文各写一遍结构。
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  kind: "privacy" | "terms";
}

const { kind } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const doc = t.legal[kind];
---

<Container>
  <Sectionhead>
    <Fragment slot="title">{doc.title}</Fragment>
    <Fragment slot="desc">{doc.description}</Fragment>
  </Sectionhead>

  <div class="mx-auto max-w-2xl mt-14">
    {
      doc.sections.map((section) => (
        <section class="border-t border-gray-200 pt-6 mt-8 first:mt-0">
          <h2 class="text-lg font-semibold text-gray-900">{section.heading}</h2>
          <p class="text-slate-600 mt-2 leading-relaxed">{section.body}</p>
        </section>
      ))
    }

    <p class="text-sm text-slate-400 mt-10">
      {t.legal.lastUpdated}
    </p>
  </div>
</Container>
