---
// 2026-10-30 - 翻转全站架构为中文默认根路径，英文加 /en 前缀，修复 TS 错误。
// 2026-10-24 - 底部 CTA 由单行文字链接升级为极简双按钮模块：
// 主按钮指向价格页、次按钮指向联系页，英文站链接加 /en 前缀。
// 版式为「左侧一句引导 + 右侧两按钮」，md 以下自动堆叠，沿用页面既有间距节奏。
// 2026-10-24 - 双语支持：关于页正文抽为视图组件，中英共用结构、字典提供文案。
// 2026-10-24 - 移除团队区块：team 集合已停用（目录为空，每次构建产生两条警告）。
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Link from "@/components/ui/link.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 2026-10-30 - 前缀逻辑随架构翻转：英文站走 /en 前缀，中文在根路径
const prefix = lang === "en" ? "/en" : "";
const pricingHref = `${prefix}/pricing`;
const contactHref = `${prefix}/contact`;
---

<Container>
  <Sectionhead>
    <Fragment slot="title">{t.about.title}</Fragment>
    <Fragment slot="desc">{t.about.sub}</Fragment>
  </Sectionhead>

  <div class="flex flex-col gap-4 mx-auto max-w-3xl mt-16">
    <h2 class="font-bold text-3xl text-gray-800">
      {t.about.heading}
    </h2>
    {
      t.about.paragraphs.map((paragraph) => (
        <p class="text-lg leading-relaxed text-slate-500">{paragraph}</p>
      ))
    }
  </div>

  <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-4xl mt-16">
    {
      t.about.values.map((value) => (
        <div class="border-t border-gray-200 pt-5">
          <h3 class="font-semibold text-lg text-gray-800">{value.title}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed text-[15px]">
            {value.body}
          </p>
        </div>
      ))
    }
  </div>

  <section class="mx-auto max-w-4xl mt-24 pt-10 border-t border-gray-200">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 md:gap-10"
    >
      <p class="text-xl md:text-2xl font-semibold tracking-tight max-w-lg">
        {t.about.ctaTitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <Link href={pricingHref} size="md">{t.about.ctaPrimary}</Link>
        <Link href={contactHref} size="md" style="outline">
          {t.about.ctaSecondary}
        </Link>
      </div>
    </div>
  </section>
</Container>
