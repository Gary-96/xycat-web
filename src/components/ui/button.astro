---
// 2026-10-23 - XIYUE rebrand: 补齐 inverted 样式，使 styles 映射与 Props 联合类型一致。
// 原先类型声明允许 "inverted" 但映射表缺该键，调用时 styles[style] 为 undefined，
// 按钮会渲染成无背景无边框的裸文本。改为 satisfies 让编译器强制两者对齐。
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "border-2 border-black hover:bg-black text-black hover:text-white",
  primary:
    "bg-black text-white hover:bg-slate-900  border-2 border-transparent",
  inverted:
    "bg-white text-black hover:bg-gray-100 border-2 border-transparent",
} satisfies Record<NonNullable<Props["style"]>, string>;
---

<button
  {...rest}
  class:list={[
    "rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
