---
import { Icon } from "astro-icon/components";

// 功能模块。TODO: 4 项能力描述为提案，需与真实产品能力核对后替换
const features = [
  {
    title: "Write without the blank page",
    description:
      "Draft scripts, captions, and long-form posts from a single brief. Keep your voice; skip the first-hour stall.",
    icon: "bx:bxs-edit-alt",
  },
  {
    title: "Visuals that fit the brief",
    description:
      "Generate and resize images for every channel from one prompt. No more exporting six versions of the same post.",
    icon: "bx:bxs-image",
  },
  {
    title: "Cut video by text",
    description:
      "Edit footage by editing the transcript. Remove filler words, tighten pacing, export in one pass.",
    icon: "bx:bxs-video",
  },
  {
    title: "Voice in any language",
    description:
      "Voiceover and subtitles that stay in sync with your cut, across the languages your audience actually speaks.",
    icon: "bx:bxs-microphone",
  },
  {
    title: "One library, every asset",
    description:
      "Every prompt, draft, and export in one searchable place. Nothing gets lost between tools.",
    icon: "bx:bxs-folder",
  },
  {
    title: "Built for teams of one",
    description:
      "No seats to buy, no onboarding call. Open the tab and ship.",
    icon: "bx:bxs-user",
  },
];
---

<section id="features" class="scroll-mt-24">
  <div class="mt-16 md:mt-0">
    <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
      Everything around the work, handled.
    </h2>
    <p class="text-lg mt-4 text-slate-600 max-w-2xl">
      Six tools that cover the parts of publishing nobody enjoys. One account,
      one library, no tab-hopping.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-x-16 gap-y-12">
    {
      features.map((item) => (
        <div class="flex gap-4 items-start">
          <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
            <Icon class="text-white" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>
            <p class="text-slate-500 mt-2 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
