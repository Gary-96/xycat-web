---
// 2026-10-24 - 产品架构重构：功能卡片由模板的六项泛化能力（写作/图像/剪辑/配音/素材库/团队）
// 收敛为实际三大直播工具 Translate / Prompter / Recorder。
// 每项独立成段并挂载锚点 id，供导航下拉与页脚链接平滑定位。
// 同时移除已不再使用的 astro-icon 引入，避免留下废弃依赖引用。
interface Product {
  /** 锚点 id，与 src/config.ts 中导航路径保持一致 */
  id: string;
  name: string;
  kicker: string;
  headline: string;
  subtext: string;
  points: string[];
}

const products: Product[] = [
  {
    id: "translate",
    name: "Translate",
    kicker: "Real-time voice & subtitle translation",
    headline: "Say it once. Stream it in every language.",
    subtext:
      "Real-time AI voice and subtitle translation for live streamers. Your audience hears you in their own language while the subtitles keep pace with the conversation.",
    points: ["Live voice", "Synced subtitles", "Low latency"],
  },
  {
    id: "prompter",
    name: "Prompter",
    kicker: "Adaptive teleprompter",
    headline: "The script that keeps up with you.",
    subtext:
      "A smart adaptive teleprompter for creators and live shows. It follows your pace, reflows when you improvise, and stays out of the frame.",
    points: ["Pace-adaptive", "Auto reflow", "Off-camera"],
  },
  {
    id: "recorder",
    name: "Recorder",
    kicker: "Multi-platform stream recording",
    headline: "Every platform, captured once.",
    subtext:
      "Automated multi-platform stream recording and archiving. Point it at a channel and it keeps a clean copy — no screen capture, no babysitting.",
    points: ["Multi-platform", "Auto archive", "Clean source"],
  },
];
---

<section id="features" class="scroll-mt-24">
  <div class="mt-16 md:mt-0">
    <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
      Three tools for going live.
    </h2>
    <p class="text-lg mt-4 text-slate-600 max-w-2xl">
      Translate what you say, prompt what you planned, record what happened —
      without switching apps mid-stream.
    </p>
  </div>

  <div class="mt-16 border-t border-gray-200">
    {
      products.map((product, index) => (
        <article
          id={product.id}
          class="scroll-mt-28 py-12 md:py-16 grid md:grid-cols-[200px_1fr] gap-6 md:gap-16 border-b border-gray-200"
        >
          <div>
            <span class="text-xs tracking-[0.18em] text-gray-400 font-semibold">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="text-2xl font-bold tracking-tight mt-2">
              {product.name}
            </h3>
            <p class="text-sm text-slate-500 mt-1 leading-relaxed">
              {product.kicker}
            </p>
          </div>

          <div>
            <p class="text-2xl md:text-3xl font-semibold tracking-tight">
              {product.headline}
            </p>
            <p class="text-slate-600 mt-4 leading-relaxed max-w-2xl">
              {product.subtext}
            </p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {product.points.map((point) => (
                <li class="text-xs text-slate-600 border border-gray-200 rounded-full px-3 py-1">
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
