---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
import { site } from "@/config";

// TODO: 接入真实注册地址后替换
const signupHref = "/pricing";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24"
>
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt=""
      widths={[200, 400, 520]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      formats={["avif", "webp"]}
    />
  </div>
  <div>
    <p class="text-xs uppercase tracking-[0.18em] text-gray-400 font-semibold">
      {site.positioning}
    </p>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter mt-4"
    >
      AI tools for people who make things.
    </h1>
    <p class="text-lg mt-5 text-slate-600 max-w-xl">
      {site.name} handles the repetitive parts of creation — drafting, editing,
      translating, resizing, voicing — so your hours go to the work that
      actually needs you.
    </p>
    <div class="mt-7 flex flex-col sm:flex-row gap-3">
      <Link
        href={signupHref}
        class="flex gap-2 items-center justify-center"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxs-right-arrow-alt" />
        Start free
      </Link>
      <Link
        size="lg"
        style="outline"
        href="#features"
        class="flex gap-2 items-center justify-center">
        See what's inside
      </Link>
    </div>
    <p class="mt-4 text-sm text-slate-400">Free to try. No card required.</p>
  </div>
</main>
