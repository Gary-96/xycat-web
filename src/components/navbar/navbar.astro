---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { site, navigation } from "@/config";

const pathname = Astro.url.pathname;

// 仅在无下拉的顶级链接上判定当前页
const isActive = (path: string) =>
  path !== "/" && pathname.startsWith(path.replace(/\/$/, ""));

// 主行动按钮。TODO: 接入真实注册地址后替换
const signupHref = "/pricing";
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg" aria-label={`${site.name} — home`}>
          <span
            class="font-bold text-slate-900 tracking-[0.28em] text-base align-middle"
            >{site.name}</span
          >
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            navigation.map((item) => (
              <>
                {item.children ? (
                  <Dropdown title={item.title} children={item.children} />
                ) : (
                  <li>
                    <a
                      href={item.path}
                      aria-current={isActive(item.path) ? "page" : undefined}
                      class:list={[
                        "flex lg:px-3 py-2 items-center hover:text-gray-900",
                        isActive(item.path) ? "text-gray-900" : "text-gray-600",
                      ]}
                    >
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href={signupHref} style="muted" block size="md">Log in</Link>
          <Link href={signupHref} size="md" block>Start free</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a
          href={signupHref}
          class="text-gray-600 hover:text-gray-900 transition">Log in</a
        >
        <Link href={signupHref} size="md">Start free</Link>
      </div>
    </div>
  </header>
</Container>
