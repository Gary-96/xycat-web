---
// 2026-10-30 - 翻转全站架构为中文默认根路径，英文加 /en 前缀，修复 TS 错误。
// 2026-10-24 - 导航品牌升级：融合几何科技猫耳/声波图标、呼吸指示点与业务后缀，提升辨识度与高级感。
// 2026-10-24 - 导航改为 sticky 固定顶栏：sticky 包裹层移出 Container 全宽铺满
//（白底 + 底部细线），滚动时不再隐藏；header 原 my-5 改 py-5 保持纵向节奏。
// 锚点偏移复用各 section 既有 scroll-mt-*（≥ 固定栏高度），无需额外处理；
// z-40 保证滚动内容从栏下穿过，下拉面板 z-10 在栏的堆叠上下文内不受影响。
// 2026-10-24 - 导航新增文档中心入口（en: Docs / zh: 使用说明），指向 /docs 与 /en/docs。
// 2026-10-24 - 双语支持：导航文案与路径改由 src/i18n/ui.ts 提供，
// 右上角增加语言切换器。
// 2026-10-30 - 前缀逻辑随架构翻转：英文站所有路径带 /en 前缀（/en/#features），
// 中文站落在根路径（/#features），不能简单给中文路径加前缀（中文首页就是 /）。
// 2026-10-23 - XIYUE rebrand: 站名改 XIYUE 字标；删除 "Pro Version" 模板外链；
// 移除无目标的 Log in / Sign up 死链，右侧只保留单一主行动 "Start free"。
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import LangSwitcher from "@/components/lang-switcher.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { site } from "@/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;

// 英文页面的路径前缀；中文为默认语言，落在根路径（不带前缀）
const prefix = lang === "en" ? "/en" : "";

interface MenuItem {
  title: string;
  path: string;
  children?: { title: string; path: string }[];
}

const menuItems: MenuItem[] = [
  { title: t.nav.product, path: `${prefix}/#features`, children: t.nav.products },
  { title: t.nav.pricing, path: `${prefix}/pricing` },
  { title: t.nav.about, path: `${prefix}/about` },
  { title: t.nav.docs, path: `${prefix}/docs` },
  ...(lang === "en" ? [{ title: t.nav.blog, path: `${prefix}/blog` }] : []),
  { title: t.nav.contact, path: `${prefix}/contact` },
];

// 仅在无下拉的顶级链接上判定当前页
const isActive = (path: string) =>
  path !== "/" && pathname.startsWith(path.replace(/\/$/, ""));

// 主行动按钮。TODO: 接入真实注册地址后替换
const signupHref = `${prefix}/pricing`;
---

<div class="sticky top-0 z-40 border-b border-gray-100 bg-white">
  <Container>
    <header class="flex flex-col lg:flex-row justify-between items-center py-5">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href={`${prefix}/`} class="flex items-center gap-2.5 group" aria-label={`${site.name} — home`}>
            <div class="relative w-8 h-8 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center shadow-sm group-hover:bg-black group-hover:scale-105 transition-all duration-200">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 18V8.5L7.5 12h9L20 8.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
                <circle cx="12" cy="15" r="1.5" fill="currentColor" />
              </svg>
              <span class="absolute -top-0.5 -right-0.5 flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
            </div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-extrabold text-slate-900 tracking-tight text-lg leading-none">
                {site.name}
              </span>
              <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase leading-none">
                {lang === "zh" ? "创作者工具" : "Live Tools"}
              </span>
            </div>
          </a>
          <div class="block lg:hidden">
            <MenuIcon class="w-4 h-4 text-gray-800" />
          </div>
        </div>
        <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
          <ul class="flex flex-col lg:flex-row lg:gap-3">
            {
              menuItems.map((item) => (
                <>
                  {item.children ? (
                    <Dropdown title={item.title} children={item.children} />
                  ) : (
                    <li>
                      <a
                        href={item.path}
                        aria-current={isActive(item.path) ? "page" : undefined}
                        class:list={[
                          "flex lg:px-3 py-2 items-center hover:text-gray-900",
                          isActive(item.path) ? "text-gray-900" : "text-gray-600",
                        ]}
                      >
                        <span>{item.title}</span>
                      </a>
                    </li>
                  )}
                </>
              ))
            }
          </ul>
          <div class="lg:hidden flex items-center justify-between gap-4 mt-4 pt-4 border-t border-gray-100">
            <LangSwitcher />
            <Link href={signupHref} size="md">{t.nav.startFree}</Link>
          </div>
        </MenuItems>
      </Astronav>
      <div>
        <div class="hidden lg:flex items-center gap-5">
          <LangSwitcher />
          <span class="h-4 w-px bg-gray-200" aria-hidden="true"></span>
          <Link href={signupHref} size="md">{t.nav.startFree}</Link>
        </div>
      </div>
    </header>
  </Container>
</div>
