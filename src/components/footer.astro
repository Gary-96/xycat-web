---
// 2026-10-23 - XIYUE rebrand: 移除模板作者反链 "Made by Web3Templates"，改为 "Built with Astro"；
// 版权改为 XIYUE；底部补充邮箱直跳。品牌与导航均由 src/config.ts 提供。
import { site, footerNav } from "@/config";
---

<footer class="mt-24 pt-10 pb-14 border-t border-gray-200">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" class="text-base" aria-label={`${site.name} — home`}>
          <span class="font-bold text-slate-900 tracking-[0.28em]"
            >{site.name}</span
          >
        </a>
        <p class="mt-3 text-sm text-slate-500 max-w-xs leading-relaxed">
          {site.tagline}
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 inline-block text-sm text-slate-600 hover:text-gray-900 transition"
          >{site.email}</a
        >
      </div>
      {
        footerNav.map((col) => (
          <div>
            <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold">
              {col.title}
            </h3>
            <ul class="mt-3 space-y-2">
              {col.items.map((item) => (
                <li>
                  <a
                    href={item.path}
                    class="text-sm text-slate-600 hover:text-gray-900 transition"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="mt-12 pt-6 border-t border-gray-100 flex flex-col sm:flex-row gap-3 justify-between text-xs text-slate-500"
    >
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href={`mailto:${site.email}`}
          class="hover:text-gray-900 transition">{site.email}</a
        >
        <span>Built with Astro</span>
      </div>
    </div>
  </div>
</footer>
