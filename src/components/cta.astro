---
// 2026-10-30 - 翻转全站架构为中文默认根路径，英文加 /en 前缀，修复 TS 错误。
// 2026-10-24 - 双语支持：CTA 区块文案改由字典提供，英文站按钮链接加 /en 前缀。
import Link from "./ui/link.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// TODO: 接入真实注册地址后替换
// 2026-10-30 - 中文 CTA 指向根路径 /pricing，英文指向 /en/pricing
const signupHref = lang === "en" ? "/en/pricing" : "/pricing";
---

<div
  class="bg-black p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center"
>
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    {t.cta.title}
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl">
    {t.cta.sub}
  </p>
  <div class="flex mt-6">
    <Link href={signupHref} style="inverted">{t.cta.button}</Link>
  </div>
</div>
