---
import Button from "./ui/button.astro";
import { site } from "@/config";

// Web3Forms 访问密钥：在 .env 中配置 PUBLIC_WEB3FORMS_KEY
// 未配置时表单不会发起请求，而是直接提示用邮箱联系，避免静默丢失线索。
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";

const fieldClass =
  "w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100 aria-[invalid=true]:border-red-500";
---

<!--
  表单提交依赖 https://web3forms.com/ 的免费访问密钥。
  1. 在 web3forms.com 用 hello@xycat.com 注册并获取 access key
  2. 写入项目根目录 .env：PUBLIC_WEB3FORMS_KEY=xxxxx
  3. 重新构建
-->
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="contact-form"
  class="space-y-5"
  data-access-key={accessKey}
  data-email={site.email}
  novalidate
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New message from xycat.com" />
  <input
    type="checkbox"
    class="hidden"
    style="display:none"
    name="botcheck"
    tabindex="-1"
    autocomplete="off"
  />

  <div>
    <label for="cf-name" class="block text-sm font-medium text-gray-800 mb-1.5"
      >Full name</label
    >
    <input
      id="cf-name"
      type="text"
      name="name"
      placeholder="Jane Chen"
      autocomplete="name"
      required
      aria-describedby="cf-name-error"
      class={fieldClass}
    />
    <p id="cf-name-error" class="hidden text-red-600 text-sm mt-1">
      Please add your name.
    </p>
  </div>

  <div>
    <label for="cf-email" class="block text-sm font-medium text-gray-800 mb-1.5"
      >Email</label
    >
    <input
      id="cf-email"
      type="email"
      name="email"
      placeholder="you@studio.com"
      autocomplete="email"
      required
      aria-describedby="cf-email-error"
      class={fieldClass}
    />
    <p id="cf-email-error" class="hidden text-red-600 text-sm mt-1">
      We need an email to reply to.
    </p>
  </div>

  <div>
    <label
      for="cf-message"
      class="block text-sm font-medium text-gray-800 mb-1.5"
      >What are you working on?</label
    >
    <textarea
      id="cf-message"
      name="message"
      rows="6"
      placeholder="A rough idea is enough."
      required
      aria-describedby="cf-message-error"
      class={`${fieldClass} resize-y`}></textarea>
    <p id="cf-message-error" class="hidden text-red-600 text-sm mt-1">
      Add a message so we know what you need.
    </p>
  </div>

  <Button type="submit" size="lg" block id="cf-submit">Send message</Button>

  <p
    id="cf-result"
    role="status"
    aria-live="polite"
    class="text-sm text-center min-h-[1.5rem]"
  >
  </p>
</form>

<script is:inline>
  (() => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const result = document.getElementById("cf-result");
    const submit = document.getElementById("cf-submit");
    const accessKey = form.dataset.accessKey || "";
    const email = form.dataset.email || "";
    const submitLabel = submit ? submit.textContent : "Send message";

    const fields = [
      { input: "cf-name", error: "cf-name-error", message: "Please add your name." },
      { input: "cf-email", error: "cf-email-error", message: "That email doesn't look right." },
      { input: "cf-message", error: "cf-message-error", message: "Add a message so we know what you need." },
    ];

    const show = (el, text, tone) => {
      if (!el) return;
      el.textContent = text;
      el.className = "text-sm text-center min-h-[1.5rem] " + tone;
    };

    const clearErrors = () => {
      fields.forEach(({ input, error }) => {
        const field = document.getElementById(input);
        const node = document.getElementById(error);
        if (field) field.removeAttribute("aria-invalid");
        if (node) node.classList.add("hidden");
      });
    };

    const validate = () => {
      let firstInvalid = null;
      fields.forEach(({ input, error, message }) => {
        const field = document.getElementById(input);
        const node = document.getElementById(error);
        if (!field || !node) return;
        const valid = field.checkValidity() && field.value.trim() !== "";
        if (valid) {
          field.removeAttribute("aria-invalid");
          node.classList.add("hidden");
        } else {
          field.setAttribute("aria-invalid", "true");
          node.textContent = message;
          node.classList.remove("hidden");
          if (!firstInvalid) firstInvalid = field;
        }
      });
      return firstInvalid;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      show(result, "", "");

      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      // 未配置密钥：不发请求，直接给可执行的兜底方案
      if (!accessKey) {
        show(
          result,
          `That didn't go through. Email ${email} and we'll pick it up there.`,
          "text-red-600"
        );
        return;
      }

      const payload = Object.fromEntries(new FormData(form));
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Sending…";
      }
      show(result, "Sending…", "text-slate-500");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          form.reset();
          clearErrors();
          show(result, "Got it — we'll reply within two business days.", "text-green-700");
        } else {
          show(
            result,
            `That didn't go through. Email ${email} and we'll pick it up there.`,
            "text-red-600"
          );
        }
      } catch (error) {
        show(
          result,
          `That didn't go through. Email ${email} and we'll pick it up there.`,
          "text-red-600"
        );
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  })();
</script>
