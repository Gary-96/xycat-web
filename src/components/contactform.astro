---
// 2026-10-24 - 双语支持：字段标签、占位符、校验与状态文案改由字典提供。
// 因为脚本是 is:inline（构建期不处理 import），状态文案通过 data-* 传给前端，
// 校验错误文案直接由 SSR 渲染进对应节点，脚本只负责显隐，不再硬编码任何英文。
// 2026-10-23 - 联系表单完整组件（接入 Web3Forms 密钥与无障碍支持）
import Button from "./ui/button.astro";
import { site } from "@/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.contact.form;

// 密钥支持环境变量覆盖，未配置时回落到已申请的真实密钥。
// 该 key 会出现在前端产物中（Web3Forms 设计如此），轮换时改 .env 即可，无需改代码。
const accessKey =
  import.meta.env.PUBLIC_WEB3FORMS_KEY || "f6a37588-febb-4f3b-9912-9773f2dd0bb6";
const supportEmail = site.email;

const fieldClass =
  "w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100 aria-[invalid=true]:border-red-500";
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="contact-form"
  class="space-y-5"
  data-access-key={accessKey}
  data-email={supportEmail}
  data-msg-sending={f.sending}
  data-msg-success={f.success}
  data-msg-failure={f.failure}
  novalidate
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={f.subject} />
  <input
    type="checkbox"
    class="hidden"
    style="display:none"
    name="botcheck"
    tabindex="-1"
    autocomplete="off"
  />

  <div>
    <label for="cf-name" class="block text-sm font-medium text-gray-800 mb-1.5"
      >{f.name.label}</label
    >
    <input
      id="cf-name"
      type="text"
      name="name"
      placeholder={f.name.placeholder}
      autocomplete="name"
      required
      aria-describedby="cf-name-error"
      class={fieldClass}
    />
    <p id="cf-name-error" class="hidden text-red-600 text-sm mt-1">
      {f.name.error}
    </p>
  </div>

  <div>
    <label for="cf-email" class="block text-sm font-medium text-gray-800 mb-1.5"
      >{f.email.label}</label
    >
    <input
      id="cf-email"
      type="email"
      name="email"
      placeholder={f.email.placeholder}
      autocomplete="email"
      required
      aria-describedby="cf-email-error"
      class={fieldClass}
    />
    <p id="cf-email-error" class="hidden text-red-600 text-sm mt-1">
      {f.email.error}
    </p>
  </div>

  <div>
    <label
      for="cf-message"
      class="block text-sm font-medium text-gray-800 mb-1.5"
      >{f.message.label}</label
    >
    <textarea
      id="cf-message"
      name="message"
      rows="6"
      placeholder={f.message.placeholder}
      required
      aria-describedby="cf-message-error"
      class={`${fieldClass} resize-y`}></textarea>
    <p id="cf-message-error" class="hidden text-red-600 text-sm mt-1">
      {f.message.error}
    </p>
  </div>

  <Button type="submit" size="lg" block id="cf-submit">{f.submit}</Button>

  <p
    id="cf-result"
    role="status"
    aria-live="polite"
    class="text-sm text-center min-h-[1.5rem]"
  >
  </p>
</form>

<script is:inline>
  (() => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const result = document.getElementById("cf-result");
    const submit = document.getElementById("cf-submit");
    const accessKey = form.dataset.accessKey || "";
    const email = form.dataset.email || "";
    const msgSending = form.dataset.msgSending || "";
    const msgSuccess = form.dataset.msgSuccess || "";
    const msgFailure = (form.dataset.msgFailure || "").replace("{email}", email);
    const submitLabel = submit ? submit.textContent : "";

    const fieldIds = ["cf-name", "cf-email", "cf-message"];

    const show = (text, tone) => {
      if (!result) return;
      result.textContent = text;
      result.className = "text-sm text-center min-h-[1.5rem] " + tone;
    };

    const clearErrors = () => {
      fieldIds.forEach((id) => {
        const field = document.getElementById(id);
        const node = document.getElementById(id + "-error");
        if (field) field.removeAttribute("aria-invalid");
        if (node) node.classList.add("hidden");
      });
    };

    const validate = () => {
      let firstInvalid = null;
      fieldIds.forEach((id) => {
        const field = document.getElementById(id);
        const node = document.getElementById(id + "-error");
        if (!field || !node) return;
        const valid = field.checkValidity() && field.value.trim() !== "";
        if (valid) {
          field.removeAttribute("aria-invalid");
          node.classList.add("hidden");
        } else {
          field.setAttribute("aria-invalid", "true");
          node.classList.remove("hidden");
          if (!firstInvalid) firstInvalid = field;
        }
      });
      return firstInvalid;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      show("", "");

      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      // 2026-10-24 - No key configured: skip the request and show the fallback path instead.
      if (!accessKey) {
        show(msgFailure, "text-red-600");
        return;
      }

      const payload = Object.fromEntries(new FormData(form));
      if (submit) {
        submit.disabled = true;
        submit.textContent = msgSending;
      }
      show(msgSending, "text-slate-500");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          form.reset();
          clearErrors();
          show(msgSuccess, "text-green-700");
        } else {
          show(msgFailure, "text-red-600");
        }
      } catch (error) {
        show(msgFailure, "text-red-600");
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  })();
</script>
