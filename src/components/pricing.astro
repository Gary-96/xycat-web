---
import { Tick } from "@/components/ui/icons";
import Link from "@/components/ui/link.astro";
import type { Plan } from "@/types";

const { plan } = Astro.props as { plan: Plan };

const isObjectPrice = typeof plan.price === "object";
---

<div
  class:list={[
    "flex flex-col w-full py-6 px-6 rounded-md border-2",
    plan.popular ? "border-black" : "border-[#D8DEE9]/60",
  ]}
>
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-lg font-medium text-gray-800">{plan.name}</h2>
      <p class="text-sm text-slate-500 mt-1">{plan.subtitle}</p>
    </div>
    {
      plan.popular && (
        <span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white bg-black rounded-full shrink-0">
          Popular
        </span>
      )
    }
  </div>

  <p class="mt-6 text-4xl font-bold text-black tracking-tight">
    {isObjectPrice ? (plan.price as { monthly: string }).monthly : plan.price}
  </p>
  {
    isObjectPrice && (
      <p class="mt-1 text-sm text-slate-500">
        {(plan.price as { annual: string }).annual} billed yearly
      </p>
    )
  }

  <ul class="grid mt-8 text-left gap-y-4 flex-1">
    {
      plan.features.map((item) => (
        <li class="flex items-start gap-3 text-gray-800 text-[15px]">
          <Tick class="w-5 h-5 shrink-0 mt-0.5" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="flex mt-8">
    <Link
      href={plan.button.link || "#"}
      block
      size="md"
      style={plan.popular ? "primary" : "outline"}
    >
      {plan.button.text || "Start free"}
    </Link>
  </div>
</div>
