---
// 2026-10-23 - XIYUE rebrand: 档位重构为 Free / Creator / Studio（原 Personal / Startup / Enterprise
// 面向 B 端 SaaS，与创作者受众不符）；清理原先被注释的价格划线死代码，
// 改由组件根据 price 是字符串还是 {monthly, annual} 决定展示方式。
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";
import type { Plan } from "@/types";

// TODO: 三档命名、价格与额度均为提案，需按真实定价替换
const pricing: Plan[] = [
  {
    name: "Free",
    subtitle: "For trying things out",
    price: "$0",
    features: [
      "1 project",
      "20 generations per month",
      "Watermark on exports",
      "Community support",
    ],
    button: { text: "Start free", link: "/pricing" },
  },
  {
    name: "Creator",
    subtitle: "For people who publish every week",
    price: { monthly: "$19", annual: "$16" },
    popular: true,
    features: [
      "Unlimited projects",
      "1,000 generations per month",
      "No watermark",
      "Full export formats",
      "Priority support",
    ],
    button: { text: "Start free", link: "/pricing" },
  },
  {
    name: "Studio",
    subtitle: "For teams with a pipeline",
    price: "Custom",
    features: [
      "Everything in Creator",
      "Shared library",
      "Up to 10 members",
      "SSO",
      "Dedicated contact",
    ],
    button: { text: "Talk to us", link: "/contact" },
  },
];
---

<Layout
  title="Pricing"
  description="Simple pricing for creators. Start free, upgrade when you publish every week. No seats to count, no annual lock-in."
>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Pricing</Fragment>
      <Fragment slot="desc">
        Simple pricing. No seats to count, no annual lock-in.
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-3 gap-8 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>

    <p class="text-center text-sm text-slate-500 mt-10">
      Prices in USD. Cancel anytime.
    </p>
  </Container>
</Layout>
