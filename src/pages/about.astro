---
// 2026-10-23 - XIYUE rebrand: 重写关于页文案；移除模板虚构团队成员（Janette / Marcell / Robert），
// 团队区块改为「有真实成员才渲染」，无数据时整块隐藏，避免展示虚假信息。
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// 只展示已发布且日期已到的成员；无成员时整块隐藏
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

const values = [
  {
    title: "Craft first",
    body: "The output has to be good enough to publish. We'd rather ship three things that work than thirty that almost do.",
  },
  {
    title: "Plain tools",
    body: "If it needs a tutorial, it's not finished. Every feature has to be obvious by the second use.",
  },
  {
    title: "Your work stays yours",
    // TODO: 若隐私条款未承诺"不用于训练"，删去后半句
    body: "You keep full rights to everything you make. We don't train on your projects.",
  },
];
---

<Layout
  title="About"
  description="XIYUE is a small team of creators and engineers building AI tools for the people who make things. Here's what we believe."
>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Built for the people who ship.</Fragment>
      <Fragment slot="desc">
        A small team of creators and engineers, making the tools we wanted for
        ourselves.
      </Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-4 mx-auto max-w-3xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">
        We got tired of the busywork.
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Every tool we tried was built for a company buying software, not for a
        person making something on a Tuesday night. They sold seats, dashboards,
        and workflows. None of it helped with the actual bottleneck: the hours
        spent resizing, re-cutting, re-writing, re-uploading.
      </p>
      <p class="text-lg leading-relaxed text-slate-500">
        So we built the opposite. Tools that do one job, do it well, and get out
        of the way. No dashboards to learn. No output that sounds like a robot
        wrote it. Just the repetitive parts, handled.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-4xl mt-16">
      {
        values.map((value) => (
          <div class="border-t border-gray-200 pt-5">
            <h3 class="font-semibold text-lg text-gray-800">{value.title}</h3>
            <p class="text-slate-500 mt-2 leading-relaxed text-[15px]">
              {value.body}
            </p>
          </div>
        ))
      }
    </div>

    {
      publishedTeamMembers.length > 0 && (
        <div class="mx-auto max-w-4xl mt-24">
          <h2 class="font-bold text-3xl text-gray-800">The team</h2>
          <div class="grid md:grid-cols-3 gap-10 mt-10">
            {publishedTeamMembers.map((member) => (
              <div class="group">
                <div class="w-full aspect-square">
                  <Picture
                    src={member.data.avatar}
                    alt={member.data.name}
                    sizes="(max-width: 800px) 100vw, 400px"
                    width={400}
                    height={400}
                    loading="lazy"
                    class="w-full rounded-sm transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                  />
                </div>
                <div class="mt-4">
                  <h3 class="text-lg text-gray-800">{member.data.name}</h3>
                  <p class="text-sm text-slate-500">{member.data.title}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <p class="text-center text-slate-500 mt-20">
      Want to talk? <a href="/contact" class="underline hover:text-gray-900"
        >Send us a note</a
      >.
    </p>
  </Container>
</Layout>
