---
// 2026-10-24 - 双语支持：404 文案改由字典提供（跟随请求语言），并标记 noindex，
// 避免错误页被搜索引擎收录。
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === "zh" ? "/zh/" : "/";
const contactHref = lang === "zh" ? "/zh/contact" : "/contact";
---

<Layout
  title={t.meta.notFound.title}
  description={t.meta.notFound.description}
  noindex
>
  <Container>
    <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center">
      <div class="mt-16 text-center max-w-md">
        <p class="text-xs uppercase tracking-[0.18em] text-gray-400 font-semibold">
          {t.notFound.label}
        </p>
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-3">
          {t.notFound.title}
        </h1>
        <p class="text-lg mt-4 text-slate-600">
          {t.notFound.body}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={homeHref}
            class="bg-black text-white px-5 py-2.5 rounded-sm text-center hover:bg-gray-800 transition"
            >{t.notFound.backHome}</a
          >
          <a
            href={contactHref}
            class="border-2 border-black px-5 py-2.5 rounded-sm text-center hover:bg-gray-100 transition"
            >{t.notFound.tellUs}</a
          >
        </div>
      </div>
    </div>
  </Container>
</Layout>
