---
// 2026-10-24 - 双语支持：html lang 按语言环境切换；补 hreflang 三向互指
//（en / zh / x-default），避免中英两版被搜索引擎判为重复内容。
// 2026-10-23 - XIYUE rebrand: Layout 支持逐页 title / description / ogImage / article 元数据；
// 移除模板作者的 Twitter Handle（原 @surjithctly），在拿到真实账号前不输出 creator/site，
// 避免分享时 @ 到无关账号。canonical 与 OG 绝对地址均基于 Astro.site，域名只改一处。
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import { site } from "@/config";
import { getAlternatePaths, getLangFromUrl, useTranslations } from "@/i18n/utils";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  /** 页面标题。留空则使用品牌默认标题（仅首页） */
  title?: string;
  /** 页面描述，不传则回落到当前语言的全站默认描述 */
  description?: string;
  /** 分享图，不传则回落到 site.ogImage */
  ogImage?: string;
  /** Open Graph 类型，博客详情页传 article */
  type?: "website" | "article";
  /** 文章发布时间，type=article 时使用 */
  publishedTime?: string;
  /** 404 等不应被索引的页面传 true */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = site.ogImage,
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

// 语言以 URL 为准，与 i18n 路由配置保持一致
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const htmlLang = lang === "zh" ? "zh-CN" : "en";
const metaDescription = description ?? t.meta.home.description;

// canonical 基于 Astro.site，域名只需在 astro.config.mjs 改一处
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();

// 标题已含品牌名时不再追加，避免出现 "Why we built XIYUE — XIYUE"
const pageTitle = title
  ? title.includes(site.name)
    ? title
    : `${title} — ${site.name}`
  : `${site.name} — ${site.positioning}`;

// 中英互指的绝对地址，供 hreflang 使用
const alternates = getAlternatePaths(Astro.url.pathname);
const alternateURL = {
  en: new URL(alternates.en, Astro.site).toString(),
  zh: new URL(alternates.zh, Astro.site).toString(),
};

// 组织信息结构化数据，全站注入一次
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  alternateName: site.nameCn,
  url: site.url,
  logo: new URL("/favicon.svg", site.url).toString(),
  description: site.description,
  email: site.email,
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="alternate" hreflang="en" href={alternateURL.en} />
    <link rel="alternate" hreflang="zh" href={alternateURL.zh} />
    <link rel="alternate" hreflang="x-default" href={alternateURL.en} />

    <SEO
      title={pageTitle}
      description={metaDescription}
      canonical={canonicalURL}
      noindex={noindex}
      twitter={{
        card: "summary_large_image",
        title: pageTitle,
        description: metaDescription,
        image: ogImageURL,
        ...(site.twitter
          ? { creator: site.twitter, site: site.twitter }
          : {}),
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: type,
          title: pageTitle,
          image: ogImageURL,
        },
        image: {
          alt: `${site.name} — ${site.positioning}`,
        },
        article:
          type === "article" && publishedTime
            ? { publishedTime }
            : undefined,
      }}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgSchema)}
      is:inline
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* 懒加载图片延迟渲染，减少非首屏布局开销。
         限定到 lazy，避免影响首屏 LCP 图片。 */
      img[loading="lazy"] {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
