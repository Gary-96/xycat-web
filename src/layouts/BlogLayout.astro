---
// 2026-10-23 - XIYUE rebrand: 由「未被引用的死代码」改为详情页唯一实现；
// 透传 description / type=article / publishedTime 给 Layout，补齐文章级 OG 元数据。
import Container from "@/components/container.astro";
import { getFormattedDate } from "@/utils/all";
import Layout from "./Layout.astro";

interface Frontmatter {
  title: string;
  category: string;
  author: string;
  publishDate: Date;
  tags: string[];
  snippet?: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
---

<Layout
  title={frontmatter.title}
  description={frontmatter.snippet}
  type="article"
  publishedTime={frontmatter.publishDate.toISOString()}
>
  <Container>
    <article class="mx-auto max-w-[735px] mt-14">
      <a
        href="/blog"
        class="text-sm text-slate-500 hover:text-gray-900 transition"
        >← Blog</a
      >

      <span
        class="block mt-8 text-blue-400 uppercase tracking-wider text-sm font-medium"
      >
        {frontmatter.category}
      </span>
      <h1
        class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-2 lg:leading-tight"
      >
        {frontmatter.title}
      </h1>

      <div class="flex gap-2 mt-4 items-center flex-wrap text-sm">
        <span class="text-gray-500">{frontmatter.author}</span>
        <span class="text-gray-400">•</span>
        <time class="text-gray-500" datetime={frontmatter.publishDate.toISOString()}>
          {getFormattedDate(frontmatter.publishDate)}
        </time>
        {
          frontmatter.tags?.length > 0 && (
            <>
              <span class="text-gray-400">•</span>
              <div class="flex flex-wrap gap-3">
                {frontmatter.tags.map((tag) => (
                  <span class="text-gray-500">#{tag}</span>
                ))}
              </div>
            </>
          )
        }
      </div>

      <div class="prose prose-lg mt-10 max-w-none">
        <slot />
      </div>
    </article>

    <div class="text-center mt-14">
      <a
        href="/blog"
        class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition text-sm"
        >← Back to blog</a
      >
    </div>
  </Container>
</Layout>
